# --- Core ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://syt:syt@localhost:5432/syt?schema=public
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# --- Auth (REQUIRED in production; dev falls back to insecure defaults) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Redis (optional in dev; required for multi-instance / production) ---
REDIS_URL=redis://localhost:6379

# --- Object storage: Cloudflare R2 / any S3-compatible (PRD §8) ---
# STORAGE_DRIVER=mock keeps everything local for development.
STORAGE_DRIVER=mock
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=syt-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://media.example.com

# --- Video streaming: Cloudflare Stream (PRD §8) ---
# VIDEO_DRIVER=mock returns a sample HLS stream for development.
VIDEO_DRIVER=mock
CF_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
CF_STREAM_WEBHOOK_SECRET=
VIDEO_MAX_DURATION_SEC=3600

# --- Seed (first Super Admin) ---
SEED_ADMIN_EMAIL=admin@syt.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Misc ---
ACTIVITY_LOG_RETENTION_DAYS=180
