// SYT Platform — database schema (master.md §3)
// Server stores metadata only; media bytes live in Cloudflare Stream / R2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  CONTENT_ADMIN
  EVENT_COORDINATOR
  MEMBER
  GUEST
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum VideoStatus {
  PROCESSING
  READY
  FAILED
}

enum VideoProvider {
  CLOUDFLARE_STREAM
  YOUTUBE
  MOCK
}

enum VideoCategory {
  DOKUMENTASI_ACARA
  BEHIND_THE_SCENE
  KARYA_ANGGOTA
  LAINNYA
}

enum NewsCategory {
  PENGUMUMAN
  KEGIATAN_TERKINI
  KEGIATAN_MENDATANG
}

enum NewsStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum RsvpStatus {
  GOING
  MAYBE
  NOT_GOING
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String?
  nim          String?
  division     String?
  phone        String?
  avatarUrl    String?
  role         Role       @default(MEMBER)
  status       UserStatus @default(ACTIVE)
  lastSeenAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens   RefreshToken[]
  activityLogs    ActivityLog[]
  videos          Video[]
  musics          Music[]
  news            News[]
  events          Event[]
  rsvps           EventRsvp[]
  activityFiles   ActivityFile[]
  notifications   Notification[]
  sentInvitations Invitation[]   @relation("InvitedBy")

  @@index([role])
  @@index([status])
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  role        Role      @default(MEMBER)
  token       String    @unique
  invitedById String
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actionType String
  targetType String?
  targetId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([actionType, createdAt])
  @@index([createdAt])
}

model Video {
  id              String        @id @default(cuid())
  uploaderId      String
  uploader        User          @relation(fields: [uploaderId], references: [id])
  title           String
  description     String?
  category        VideoCategory @default(DOKUMENTASI_ACARA)
  provider        VideoProvider @default(CLOUDFLARE_STREAM)
  providerVideoId String?
  hlsUrl          String?
  embedUrl        String?
  thumbnailUrl    String?
  durationSec     Float?
  status          VideoStatus   @default(PROCESSING)
  viewCount       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([category])
}

model Music {
  id          String    @id @default(cuid())
  uploaderId  String
  uploader    User      @relation(fields: [uploaderId], references: [id])
  title       String
  artist      String
  division    String?
  album       String?
  fileKey     String
  fileUrl     String
  coverUrl    String?
  durationSec Float?
  playCount   Int       @default(0)
  releasedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
  @@index([album])
}

model News {
  id            String       @id @default(cuid())
  authorId      String
  author        User         @relation(fields: [authorId], references: [id])
  title         String
  slug          String       @unique
  content       String
  coverImageUrl String?
  category      NewsCategory @default(PENGUMUMAN)
  tags          String[]     @default([])
  status        NewsStatus   @default(DRAFT)
  publishAt     DateTime?
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, publishedAt])
  @@index([category])
}

model Event {
  id             String   @id @default(cuid())
  creatorId      String
  creator        User     @relation(fields: [creatorId], references: [id])
  title          String
  description    String?
  location       String?
  picName        String?
  startTime      DateTime
  endTime        DateTime
  attachmentUrls String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rsvps   EventRsvp[]
  folders ActivityFolder[]

  @@index([startTime])
}

model EventRsvp {
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    RsvpStatus
  updatedAt DateTime   @updatedAt

  @@id([eventId, userId])
}

model ActivityFolder {
  id        String   @id @default(cuid())
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  name      String
  division  String?
  createdAt DateTime @default(now())

  files ActivityFile[]
}

model ActivityFile {
  id         String         @id @default(cuid())
  folderId   String
  folder     ActivityFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User           @relation(fields: [uploaderId], references: [id])
  fileName   String
  fileKey    String
  fileUrl    String
  fileType   String
  sizeBytes  Int
  createdAt  DateTime       @default(now())

  @@index([folderId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}
